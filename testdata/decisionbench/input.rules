match Append = Append;
match Header = Decode;
guard Fits = Fits;
build Empty = Empty;
build Reuse = Reuse;
build Grow = Grow;

rule Empty:
  (Append $header:(Header length:0))
  => (Empty $header);

rule Reuse:
  (Append $header:(Header length:$length capacity:$capacity))
  && (Fits $length $capacity)
  => (Reuse $header);

rule Grow:
  (Append $header:(Header length:_))
  => (Grow $header);
