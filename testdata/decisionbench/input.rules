host
  Append? = Append
  Header? = Decode
  Fits = Fits
  Empty = Empty
  Reuse = Reuse
  Grow = Grow

@Empty
rewrite (Append header@(Header (length: 0))) = Empty header

@Reuse
rewrite (Append header@(Header (length: length, capacity: capacity)))
  | Fits length capacity
  =
  Reuse header

@Grow
rewrite (Append header@(Header (length: _))) = Grow header
