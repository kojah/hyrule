host
  Append? = Append
  Header? = Decode
  Fits = Fits
  Empty = Empty
  Reuse = Reuse
  Grow = Grow

@Empty
rewrite (Append (Header { length: 0 } as header)) = Empty header

@Reuse
rewrite (Append (Header { length, capacity } as header))
  | Fits length capacity
  =
  Reuse header

@Grow
rewrite (Append (Header { length: _ } as header)) = Grow header
