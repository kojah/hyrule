fn rewrite(input: Request) -> Plan
  match input
    @Positive
    Request { Text: text, A: a, B: b }
      when go! { a >= 0 && b >= 0 }
      , let total = go! { a + b } ->
      go! {
      result := Plan{Text: strings.ToUpper(text), Total: total}
      if result.Text == "" {
          result.Text = "EMPTY"
      }
      return result
    }
    @Fallback
    _ ->
      go! { Plan{Text: "invalid"} }
