type Snapshot = Snapshot
  backing: Backing
  cells: Cells
  guard: Guard
  label: Label

type SemanticKey = SemanticKey
  backing: Backing
  cells: Cells

type ExactKey = ExactKey
  backing: Backing
  cells: Cells
  guard: Guard
  label: Label

derive Snapshot
  freeze FreezeSnapshot: FreezeSignature
    backing: keep
    cells: clone
    guard: keep
    label: keep
  key SnapshotKey: KeySignature
    backing: keep
    cells: encodeCells
    guard: omit
    label: omit
  equal EqualSnapshot: EqualSignature
    backing: keep
    cells: encodeCells
    guard: omit
    label: omit
  visit VisitSnapshot: VisitSignature
    backing: apply
    cells: each
    guard: keep
    label: keep
  visit ObserveSnapshot: ObserveSignature
    backing: apply
    cells: each
    guard: keep
    label: keep
  transform TransformSnapshot: TransformSignature
    backing: apply
    cells: each
    guard: keep
    label: keep
  display DisplaySnapshot: DisplaySignature
    backing: keep
    cells: omit
    guard: keep
    label: keep
  store StoreSnapshot: StoreSignature
    backing: keep
    cells: encodeCells
    guard: keep
    label: keep
  load LoadSnapshot: LoadSignature
