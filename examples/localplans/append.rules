type Request = Request
  source: Source
  header: Header
  count: Count
  outcome: Outcome
  copies: Copies

type Header = Header
  backing: Backing
  length: Length
  capacity: Capacity

type Copy = Copy
  offset: Offset
  count: Count

host
  Reuse = Reuse
  Refused = Refused

@Fits
rewrite request@(Request (header: header@(Header (length: length, capacity: capacity)), count: count))
  | length >= 0
  , count >= 0
  , let end = length + count
  , end >= length
  , end <= capacity
  =
  request with (header: header with (length: end), outcome: ^Reuse, copies: [Copy (offset: length, count: count)])

@Decline
rewrite request = request with (outcome: ^Refused, copies: [])
