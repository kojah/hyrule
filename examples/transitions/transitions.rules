host
  Event? = MatchEvent
  Exclusive! = Exclusive

type Proof = Proof
  tag Kind
  Proven = Proven
  Disproven = Disproven
  Unknown (reason: Reason) = Unknown

type Effect = Effect
  tag Kind
  Acquire (lock: Lock) = Acquire
  Release (lock: Lock) = ReleaseNow
  DeferRelease (lock: Lock) = DeferRelease
  Order (lock: Lock) = Order
  Uncertain (lock: Lock, reason: Reason) = Uncertain

@DeferredRelease
rewrite (Event { lock, release: true, deferred: true }) = [DeferRelease { lock }]

@ImmediateRelease
rewrite (Event { lock, release: true, deferred: false }) = [Release { lock }]

@DeferredAcquisition
rewrite (Event { release: false, deferred: true }) = []

@Acquisition
rewrite (Event { lock, release: false, deferred: false }) =
  do
    proof <- Exclusive lock
    case proof of
      Proven() -> [Acquire { lock }]
      Disproven() -> [Acquire { lock }, Order { lock }]
      Unknown { reason } -> [Acquire { lock }, Uncertain { lock, reason }]
