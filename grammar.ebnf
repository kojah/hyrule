(* Hyrule equation syntax. Layout is specified in LAYOUT.md. NEWLINE separates
   logical statements; INDENT/DEDENT describe block boundaries, not characters.
   Names are resolved after parsing against all files belonging to a target. *)
file = { declaration, NEWLINE }, EOF ;
declaration = host | schema | pattern | function | equation ;
host = "host", INDENT, hostBinding, { NEWLINE, hostBinding }, DEDENT ;
hostBinding = name, [ "?" | "!" ], { name }, [ "=", application ] ;
(* A type may omit "= hostType" when the Go type has the same name. A type
   without a body derives its fields from the Go struct. *)
schema = [ "exhaustive" ], ( "type", name, [ "=", hostType ] | "view", name, "=", hostType ),
         [ INDENT, schemaBody, DEDENT ] ;
schemaBody = ( "tag", storage, NEWLINE, variant, { NEWLINE, variant } )
           | ( field, { NEWLINE, field } ) ;
hostType = storageType | "(", storageType, { ",", storageType }, ")" ;
storageType = [ "*" ], path ;
field = name, [ ":", storage ] ;
storage = path | integer ;
variant = name, [ "(", field, { ",", field }, ")" ], [ "=", path ] ;
pattern = "pattern", name, { name }, "=", patternExpression ;
(* Functions may infer their API from a Go binding. Plain fn preserves the
   implicit API; partial/total select native parameter/result lists. *)
function = [ "partial" | "total" ], "fn", name,
           [ "(", functionParameters, ")", [ "->", parameters ] ],
           [ INDENT, ( "fallback", expression, [ NEWLINE, functionBody ] | functionBody ), DEDENT ] ;
functionParameters = functionParameter, { ",", functionParameter } ;
functionParameter = name, [ ":", goType ] ;
functionBody = expression | "match", name, INDENT, functionArm,
               { NEWLINE, functionArm }, DEDENT ;
functionArm = [ "@", name, NEWLINE ], patternExpression,
              [ "when", qualifier, { ",", qualifier } ], "->", expression, [ where ] ;
parameters = parameter, { ",", parameter } ;
parameter = [ name, ":" ], goType ;
goType = "*", goType | "[", "]", goType | "map", "[", goType, "]", goType
       | path, [ "[", goType, { ",", goType }, "]" ] ;
equation = [ "@", name, NEWLINE ], name, patternExpression,
           ( "=", expression | guarded, { guarded } ), [ where ] ;
guarded = "|", qualifier, { ",", qualifier }, "=", expression ;
qualifier = "let", name, "=", disjunction
          | patternExpression, "<-", disjunction | disjunction ;
where = "where", ( whereBinding | INDENT, whereBinding,
        { NEWLINE, whereBinding }, DEDENT ) ;
whereBinding = name, "=", expression ;
expression = strategy, { "<|>", strategy } ;
strategy = "do", INDENT, { ( binding | requirement ), NEWLINE }, expression, DEDENT
         | "case", application, "of", INDENT, arm, { NEWLINE, arm }, DEDENT
         | "decline" | disjunction ;
disjunction = conjunction, { "||", conjunction } ;
conjunction = comparison, { "&&", comparison } ;
requirement = "require", disjunction ;
binding = patternExpression, "<-", application,
          [ INDENT, "else", ( arm | expression | INDENT, arm, { NEWLINE, arm }, DEDENT ), DEDENT ] ;
arm = patternExpression, "->", expression ;
comparison = sum, [ ( "==" | "!=" | "<" | "<=" | ">" | ">=" ), sum ] ;
sum = product, { ( "+" | "-" ), product } ;
product = application, { ( "*" | "/" | "%" ), application } ;
application = atom, { atom }, [ "with", namedArguments ] ;
atom = inlineGo | path, [ namedArguments ] | "^", path | literal | "_"
     | "not", atom
     | "if", disjunction, "then", expression, "else", expression
     | "(", expression, ")" | "(", ")"
     | "[", [ expression, { ",", expression } ], "]" ;
(* Bare fields expand to field: field, preserving written order. Accessor
   labels require an explicit pattern and are pattern-only. *)
namedArguments = "{", [ namedArgument, { ",", namedArgument }, [ "," ] ], "}" ;
namedArgument = name, [ ":", expression ] ;
patternExpression = patternApplication ;
patternApplication = patternAtom, { patternAtom } ;
patternAtom = patternPrimary, [ "as", name ] ;
patternPrimary = path, [ patternFields ] | "^", path | literal | "_"
               | "(", patternApplication, { "|", patternApplication }, ")"
               | "(", ")" | "[", [ listElements ], "]" ;
patternFields = "{", [ patternField, { ",", patternField }, [ "," ] ], "}" ;
patternField = name, [ ":", patternExpression ]
             | name, "(", ")", ":", patternExpression ;
(* A list pattern matches exactly its elements, or at least them with a rest. *)
listElements = patternExpression, { ",", patternExpression }, [ ",", "..", patternAtom ], [ "," ]
             | "..", patternAtom, [ "," ] ;
path = name, { ".", name } ;
name = identifier | escapedIdentifier ;
literal = [ "-" ], ( integer | float ) | string | "true" | "false" | "nil" ;
(* Lexical terminals use Unicode identifier letters/digits, Go numeric and
   quoted string literal spelling, and backtick-escaped identifiers. Negative
   numeric literals are a '-' followed by a numeric token. No raw strings. *)

(* Go braces are balanced outside Go strings, rune literals and comments.
   The body is opaque to Hyrule layout and parsed/type-checked as Go later.
   Inline Go is an expression only, never a matcher pattern. *)
inlineGo = "go", "!", "{", goBody, "}" ;
